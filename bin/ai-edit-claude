#!/usr/bin/env python3
"""ai-edit-claude: one rewrite by a fresh claude process.

Reads one request {"model", "instruction", "text"} on stdin and prints
{"text": ...} or {"error": ...}. bin/ai-edit run uses it from a terminal;
the overlay goes through Service.qml instead, which keeps claude waiting.
The two speak the same protocol: keep user_message, extract_answer and
split_padding in step with Service.qml.
"""

import json
import os
import queue
import shutil
import signal
import subprocess
import sys
import threading
import time
from collections import deque
from pathlib import Path

PLUGIN_DIR = Path(__file__).resolve().parent.parent
SYSTEM_PROMPT = (PLUGIN_DIR / "system-prompt.txt").read_text().strip()
TURN_TIMEOUT = int(os.environ.get("AI_EDIT_TURN_TIMEOUT", "60"))
MAX_REQUEST = 4 * 1024 * 1024
WORK_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "ai-edit/agent"
DEFAULT_MODEL = "sonnet"


class TurnError(Exception):
    pass


def claude_command(model):
    claude = os.environ.get("AI_EDIT_CLAUDE") or shutil.which("claude")
    if not claude:
        raise TurnError("claude is not installed")
    return [
        claude, "-p",
        "--input-format", "stream-json", "--output-format", "stream-json", "--verbose",
        "--no-session-persistence",
        "--restricted", "--tools", "",
        "--strict-mcp-config", "--mcp-config", '{"mcpServers":{}}',
        "--model", model,
        "--system-prompt", SYSTEM_PROMPT,
    ]


def user_message(instruction, text):
    content = f"{instruction}\n\n<text>\n{text}\n</text>"
    return json.dumps({
        "type": "user",
        "message": {"role": "user", "content": [{"type": "text", "text": content}]},
    }) + "\n"


def extract_answer(raw):
    # Scanned from the end: a model that repeats the instruction back names the
    # tag before it answers. Output without the tags is passed through, since
    # a model that ignored them has usually still answered.
    end = raw.rfind("</rewrite>")
    if end < 0:
        return raw
    start = raw.rfind("<rewrite>", 0, end)
    if start < 0:
        return raw
    inner = raw[start + len("<rewrite>"):end]
    inner = inner.removeprefix("\n").removesuffix("\n")
    return inner


def split_padding(text):
    # The model drops the whitespace around a selection (the newline a
    # triple-click takes along); it is put back around the answer so pasting
    # does not join two lines.
    core = text.strip()
    start = text.index(core)
    return text[:start], core, text[start + len(core):]


class Worker:
    """One claude process that serves exactly one turn."""

    def __init__(self, model, command=None, name="claude", terminate_grace=0):
        self.name = name
        self.terminate_grace = terminate_grace
        self.model = model
        self.events = queue.Queue()
        self.stderr = deque(maxlen=20)
        WORK_DIR.mkdir(parents=True, exist_ok=True)
        env = dict(os.environ, MAX_THINKING_TOKENS="0")
        self.proc = subprocess.Popen(
            command if command is not None else claude_command(model),
            cwd=WORK_DIR, env=env, text=True, bufsize=1,
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            start_new_session=True,
        )
        threading.Thread(target=self._read_stdout, daemon=True).start()
        threading.Thread(target=self._read_stderr, daemon=True).start()

    def _read_stdout(self):
        for line in self.proc.stdout:
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue
            if event.get("type") in ("result", "assistant"):
                self.events.put(event)
        self.events.put(None)

    def _read_stderr(self):
        for line in self.proc.stderr:
            line = line.strip()
            if line and not line.startswith("at "):
                self.stderr.append(line[:300])

    def failure(self, fallback):
        detail = " ".join(self.stderr) if self.stderr else ""
        return detail or fallback

    def _write(self, message):
        try:
            self.proc.stdin.write(message)
            self.proc.stdin.flush()
        except (OSError, ValueError):
            self.events.put({"type": "write_failed"})

    def turn(self, instruction, text):
        deadline = time.monotonic() + TURN_TIMEOUT
        # A large text fills the pipe, and a claude that stops reading would
        # block the write forever; written from a thread, the deadline below
        # covers it and the kill unblocks it.
        threading.Thread(target=self._write, args=(user_message(instruction, text),), daemon=True).start()
        try:
            while True:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise TurnError(f"{self.name} did not answer within {TURN_TIMEOUT} s")
                try:
                    event = self.events.get(timeout=remaining)
                except queue.Empty:
                    continue
                if event is None:
                    # stdout closed; a claude that stays alive after that is
                    # still bound by the deadline.
                    try:
                        self.proc.wait(timeout=max(0.1, deadline - time.monotonic()))
                    except subprocess.TimeoutExpired:
                        raise TurnError(f"{self.name} did not answer within {TURN_TIMEOUT} s")
                    raise TurnError(self.failure(f"{self.name} exited with status {self.proc.returncode}"))
                if event["type"] == "write_failed":
                    raise TurnError(self.failure(f"{self.name} exited before the request"))
                if event["type"] != "result":
                    continue
                result = event.get("result") or ""
                if event.get("is_error") or event.get("subtype") != "success":
                    raise TurnError(result or event.get("subtype") or f"{self.name} reported an error")
                answer = extract_answer(result)
                if not answer.strip():
                    raise TurnError(f"{self.name} returned nothing")
                return answer
        except BaseException:
            self.kill()
            raise

    def stop(self):
        try:
            self.proc.stdin.close()
        except OSError:
            pass
        try:
            self.proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            self.kill()

    def kill(self):
        if self.terminate_grace and self.proc.poll() is None:
            try:
                os.killpg(self.proc.pid, signal.SIGTERM)
                self.proc.wait(timeout=self.terminate_grace)
            except (ProcessLookupError, subprocess.TimeoutExpired):
                pass
        if self.proc.poll() is None:
            try:
                os.killpg(self.proc.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
        self.proc.wait()


def rewrite(worker, request):
    before, core, after = split_padding(request["text"])
    return before + worker.turn(request["instruction"], core) + after


def parse_request(raw):
    try:
        request = json.loads(raw)
    except json.JSONDecodeError:
        raise TurnError("request is not JSON")
    if not isinstance(request, dict):
        raise TurnError("request is not a JSON object")
    for key in ("instruction", "text"):
        if not isinstance(request.get(key), str):
            raise TurnError(f"request has no {key}")
    if not request["text"].strip():
        raise TurnError("nothing to rewrite")
    request["model"] = request.get("model") or DEFAULT_MODEL
    return request


def main():
    raw = sys.stdin.buffer.read(MAX_REQUEST + 1)
    worker = None
    if len(raw) > MAX_REQUEST:
        reply = {"error": "text is too large"}
    else:
        try:
            request = parse_request(raw)
            worker = Worker(request["model"])
            reply = {"text": rewrite(worker, request)}
        except (TurnError, OSError) as error:
            reply = {"error": str(error)}
    print(json.dumps(reply), flush=True)
    # The answer is out; claude is ended before exiting, or it would be left
    # running on its own.
    if worker:
        worker.stop()
    return 0 if "text" in reply else 1


if __name__ == "__main__":
    sys.exit(main())
