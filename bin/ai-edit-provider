#!/usr/bin/env python3
"""List backend models or remember a choice without rewriting the user's TOML."""
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True
loader = importlib.machinery.SourceFileLoader("ai_edit_config", str(Path(__file__).resolve().with_name("ai-edit-config")))
spec = importlib.util.spec_from_loader(loader.name, loader)
config = importlib.util.module_from_spec(spec)
loader.exec_module(config)


def providers():
    result = []
    selection = config.read_selection() or {}
    remembered = selection.get("models", {}) if isinstance(selection, dict) else {}
    for backend, label in (("agy", "Antigravity"), ("codex", "Codex"), ("claude", "Claude Code")):
        models = []
        if backend == "claude":
            models = [{"id": name, "label": name.capitalize()} for name in ("sonnet", "haiku", "opus")]
        elif backend == "codex":
            try:
                home = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex"))
                catalog = json.loads((home / "models_cache.json").read_text())["models"]
                models = [{"id": entry["slug"], "label": entry.get("display_name") or entry["slug"]}
                          for entry in catalog if entry.get("visibility") == "list"]
            except (OSError, ValueError, KeyError, TypeError):
                pass
        elif shutil.which("agy"):
            try:
                output = subprocess.run(["agy", "models"], capture_output=True, text=True, timeout=10)
                if output.returncode == 0:
                    for line in output.stdout.splitlines():
                        slug, separator, name = line.partition("\t")
                        if separator and slug:
                            models.append({"id": slug, "label": name})
            except (OSError, subprocess.TimeoutExpired):
                pass
        for name in (config.DEFAULT_MODELS[backend], remembered.get(backend) if isinstance(remembered, dict) else None):
            if name and not any(item["id"] == name for item in models):
                models.append({"id": name, "label": name})
        result.append({"id": backend, "label": label, "installed": bool(shutil.which(backend)),
                       "models": models, "model": remembered.get(backend, config.DEFAULT_MODELS[backend])
                       if isinstance(remembered, dict) else config.DEFAULT_MODELS[backend]})
    return result


def choose(backend, model):
    previous = config.read_selection()
    models = dict(previous.get("models", {})) if isinstance(previous, dict) and isinstance(previous.get("models"), dict) else {}
    if backend in config.DEFAULT_MODELS and model == "":
        model = models.get(backend, config.DEFAULT_MODELS[backend])
    if backend not in config.DEFAULT_MODELS or not config.is_text(model) or len(model) > 200 or any(ord(c) < 32 for c in model):
        raise ValueError("Choose a backend and a valid model ID")
    user = config.load(config.CONFIG_DIR / "config.toml")
    models[backend] = model
    selection = {"backend": backend, "models": models, "base": [user.get("backend", "agent"), user.get("model")]}
    result = config.resolve(config.load(config.PLUGIN_DIR / "config.toml"), user, selection)
    config.CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=".provider-", dir=config.CONFIG_DIR)
    try:
        with os.fdopen(descriptor, "w") as output:
            json.dump(selection, output)
            output.write("\n")
        os.replace(temporary, config.CONFIG_DIR / "provider.json")
    finally:
        Path(temporary).unlink(missing_ok=True)
    return result


if __name__ == "__main__":
    try:
        if len(sys.argv) == 4 and sys.argv[1] == "select":
            result = choose(sys.argv[2], sys.argv[3])
        elif len(sys.argv) == 2 and sys.argv[1] == "list":
            result = providers()
        else:
            raise ValueError("Usage: ai-edit-provider list | select <backend> <model>")
        print(json.dumps(result))
    except (ValueError, OSError, config.ConfigError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
