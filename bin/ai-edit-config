#!/usr/bin/env python3
"""ai-edit-config: the settings and actions as JSON on stdout.

The plugin's config.toml holds the defaults; ~/.config/ai-edit/config.toml
overrides settings key by key, and its actions, when it has any, replace the
default ones as a whole. Prints {"config": {...}, "actions": [...]} with every
action's model and preview resolved, or an error on stderr.
"""

import json
import os
import re
import shutil
import sys
import tomllib
from pathlib import Path

PLUGIN_DIR = Path(__file__).resolve().parent.parent
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "ai-edit"
SETTINGS = ("agent", "model", "fast", "preview", "compact", "width", "backend", "idle_timeout")
AGENTS = ("claude", "codex")
# The model an agent uses when the config names none.
MODELS = {"claude": "sonnet", "codex": "gpt-6.1-sol"}
CLAUDE_MODELS = ("sonnet", "haiku", "opus")


class ConfigError(Exception):
    pass


def load(path):
    try:
        with open(path, "rb") as f:
            return tomllib.load(f)
    except FileNotFoundError:
        return {}
    except tomllib.TOMLDecodeError as error:
        raise ConfigError(f"{path}: {error}")


def default_agent():
    """Claude when it is installed, being the faster; else Codex when that is."""
    if not shutil.which("claude") and shutil.which("codex"):
        return "codex"
    return "claude"


def check_model(where, agent, model):
    # A config written for one agent names models the other does not know.
    claude = model in CLAUDE_MODELS or model.startswith("claude")
    if claude != (agent == "claude") and (claude or model.startswith("gpt-")):
        raise ConfigError(f"{where}: {model} is not a model for {agent}")


def action_id(label):
    return re.sub(r"[^a-z0-9]+", "-", label.lower()).strip("-")


def is_int(value):
    return isinstance(value, int) and not isinstance(value, bool)


def is_text(value):
    return isinstance(value, str) and value.strip() != ""


CHECKS = {
    "agent": (lambda v: v in AGENTS, "claude or codex"),
    "fast": (lambda v: isinstance(v, bool), "true or false"),
    "model": (is_text, "a model name such as \"sonnet\""),
    "preview": (lambda v: isinstance(v, bool), "true or false"),
    "compact": (lambda v: isinstance(v, bool), "true or false"),
    "width": (lambda v: is_int(v) and v >= 200, "a whole number of pixels, 200 or more"),
    "backend": (is_text, "a backend name"),
    "idle_timeout": (lambda v: is_int(v) and v >= 0, "a whole number of minutes, 0 or more"),
}
ACTION_CHECKS = {key: CHECKS[key] for key in ("model", "preview")}
ACTION_CHECKS["diff"] = (lambda v: isinstance(v, bool), "true or false")
ACTION_CHECKS["id"] = (is_text, "a name")


def check(where, settings, checks):
    for key, (valid, wanted) in checks.items():
        if key in settings and not valid(settings[key]):
            raise ConfigError(f"{where}: {key} must be {wanted}")


def resolve(defaults, user):
    check(CONFIG_DIR / "config.toml", user, CHECKS)
    config = {key: defaults[key] for key in SETTINGS if key in defaults}
    config.setdefault("backend", "agent")
    config.update({key: user[key] for key in SETTINGS if key in user})
    config.setdefault("agent", default_agent())
    config.setdefault("model", MODELS[config["agent"]])
    config.setdefault("fast", True)
    check_model(CONFIG_DIR / "config.toml", config["agent"], config["model"])

    path = CONFIG_DIR / "config.toml" if "action" in user else PLUGIN_DIR / "config.toml"
    listed = user.get("action", defaults.get("action", []))
    if not isinstance(listed, list):
        raise ConfigError(f"{path}: write each action as [[action]]")
    actions, keys, ids = [], set(), set()
    for number, action in enumerate(listed, 1):
        where = f"{path}: action {number}"
        if not isinstance(action, dict):
            raise ConfigError(f"{where} is not a table")
        for field in ("key", "label", "instruction"):
            if not is_text(action.get(field)):
                raise ConfigError(f"{where} has no {field}")
        check(where, action, ACTION_CHECKS)
        if not re.fullmatch(r"[a-z]", action["key"]):
            raise ConfigError(f"{where}: key must be one lowercase letter")
        if action["key"] == "y":
            raise ConfigError(f"{where}: key y is taken: it copies a result")
        if action["key"] in keys:
            raise ConfigError(f"{where}: key {action['key']} is used twice")
        keys.add(action["key"])
        resolved = dict(action)
        # The overlay runs an action by its id, so ids must be unique and not
        # empty. A derived one that is taken gets the key, then a number.
        if "id" in action:
            if action["id"] in ids:
                raise ConfigError(f"{where}: id {action['id']} is used twice")
            resolved["id"] = action["id"]
        else:
            base = action_id(action["label"]) or action["key"]
            candidates = [base, f"{base}-{action['key']}"] + [f"{base}-{action['key']}-{n}" for n in range(2, 100)]
            resolved["id"] = next(c for c in candidates if c not in ids)
        ids.add(resolved["id"])
        resolved["instruction"] = action["instruction"].strip()
        resolved.setdefault("model", config["model"])
        check_model(where, config["agent"], resolved["model"])
        resolved.setdefault("preview", config.get("preview", True))
        actions.append(resolved)
    return {"config": config, "actions": actions}


def main():
    try:
        result = resolve(load(PLUGIN_DIR / "config.toml"), load(CONFIG_DIR / "config.toml"))
    except ConfigError as error:
        print(error, file=sys.stderr)
        return 1
    json.dump(result, sys.stdout, ensure_ascii=False)
    print()
    return 0


if __name__ == "__main__":
    sys.exit(main())
