#!/usr/bin/env python3
"""Stands in for codex: the prompt check and a stdio app-server.

The instruction in a turn picks the behaviour, as in fake-claude.
FAKE_CODEX_LEAK makes the prompt check show extra context,
FAKE_CODEX_VERSION sets what --version says; FAKE_CODEX_LOG
names a file that gets one line per start with CODEX_HOME and the settings.
"""
import json
import os
import sys
import time

args = sys.argv[1:]
settings = {k: json.loads(v) for k, v in (args[i + 1].split("=", 1) for i, a in enumerate(args) if a == "-c")}
command = [a for i, a in enumerate(args) if a != "-c" and (i == 0 or args[i - 1] != "-c")]

if os.environ.get("FAKE_CODEX_LOG"):
    with open(os.environ["FAKE_CODEX_LOG"], "a") as log:
        log.write(json.dumps({"command": command[:2], "home": os.environ.get("CODEX_HOME"),
                              "settings": settings}) + "\n")

if command == ["--version"]:
    print("codex-cli " + os.environ.get("FAKE_CODEX_VERSION", "0.1.0"))
    sys.exit(0)

if command[:2] == ["debug", "prompt-input"]:
    messages = [{"role": "developer", "content": [{"type": "input_text", "text": "<permissions instructions>read-only"}]},
                {"role": "user", "content": [{"type": "input_text", "text": command[2]}]}]
    if os.environ.get("FAKE_CODEX_LEAK"):
        messages.insert(1, {"role": "developer", "content": [{"type": "input_text", "text": "# AGENTS.md"}]})
    print(json.dumps(messages))
    sys.exit(0)

if command[:1] != ["app-server"]:
    sys.exit("fake codex: unexpected command " + " ".join(command))


def send(message):
    print(json.dumps(message), flush=True)


def notify(method, **params):
    send({"method": method, "params": dict(params, threadId="t1")})


for line in sys.stdin:
    message = json.loads(line)
    method, seq, params = message.get("method"), message.get("id"), message.get("params") or {}
    if method == "initialize":
        send({"id": seq, "result": {"userAgent": "fake"}})
    elif method == "thread/start":
        send({"id": seq, "result": {"thread": {"id": "t1"}, "model": params["model"],
                                    "serviceTier": params["serviceTier"]}})
    elif method == "turn/start":
        content = params["input"][0]["text"]
        instruction, _, rest = content.partition("\n\n")
        text = rest.removeprefix("<text>\n").removesuffix("\n</text>")
        send({"id": seq, "result": {"turn": {"id": "u1", "status": "inProgress"}}})
        if instruction == "die":
            print("Error: fake codex gave up", file=sys.stderr, flush=True)
            sys.exit(3)
        if instruction == "hang":
            time.sleep(3600)
        if instruction == "ask":
            send({"id": 99, "method": "item/commandExecution/requestApproval", "params": {"threadId": "t1"}})
            time.sleep(3600)
        if instruction == "tool":
            notify("item/completed", item={"type": "commandExecution", "command": "ls"})
        if instruction == "fail":
            notify("error", error={"message": "You've hit your usage limit."})
            notify("turn/completed", turn={"status": "failed", "error": {"message": "You've hit your usage limit."}})
            continue
        answer = f"<rewrite>{text.upper()}</rewrite>"
        if instruction == "tier":
            answer = f"<rewrite>{settings.get('service_tier')} {settings.get('model_reasoning_effort')}</rewrite>"
        notify("item/completed", item={"type": "reasoning"})
        notify("item/completed", item={"type": "agentMessage", "text": answer})
        notify("turn/completed", turn={"status": "completed"})
